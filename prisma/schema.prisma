// WhiteSVAN — trader analytics & client-reporting SaaS
// Schema docs: https://pris.ly/d/prisma-schema
// DB URL is provided via prisma.config.ts (process.env.DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Auth.js (NextAuth) models — standard adapter shape.
// NOTE: `Account` here is the OAuth/credentials provider link used
// by Auth.js. A user's *brokerage* account is `TradingAccount`.
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set for credentials sign-in
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  profile         TraderProfile?
  tradingAccounts TradingAccount[]
  reports         Report[]
  evidence        Evidence[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Application domain
// ─────────────────────────────────────────────────────────────

model TraderProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  slug        String   @unique // public portal handle: /p/[slug]
  bio         String?
  strategy    String?
  instruments String? // free text e.g. "ES, NQ, options"
  riskRules   String?
  isPublic    Boolean  @default(false)
  hideAmounts Boolean  @default(false) // redact dollar figures on the public portal
  disclaimer  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradingAccount {
  id              String   @id @default(cuid())
  userId          String
  broker          String? // e.g. "Interactive Brokers", "Topstep"
  accountName     String
  startingBalance Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades    Trade[]
  dailyPnl  DailyPnl[]
  reports   Report[]
  evidence  Evidence[]

  @@index([userId])
}

model Trade {
  id          String   @id @default(cuid())
  accountId   String
  tradeDate   DateTime @db.Date
  symbol      String
  assetType   String? // future | option | stock | ...
  side        String? // BUY | SELL | LONG | SHORT
  quantity    Decimal? @db.Decimal(18, 4)
  entryPrice  Decimal? @db.Decimal(18, 6)
  exitPrice   Decimal? @db.Decimal(18, 6)
  realizedPnl Decimal  @db.Decimal(18, 2)
  fees        Decimal  @default(0) @db.Decimal(18, 2)
  raw         Json? // original CSV row, for debugging/re-import
  createdAt   DateTime @default(now())

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, tradeDate])
}

// Per-day rollup (rebuilt from trades on import). One row per account/day.
model DailyPnl {
  id         String   @id @default(cuid())
  accountId  String
  tradeDate  DateTime @db.Date
  grossPnl   Decimal  @db.Decimal(18, 2)
  fees       Decimal  @default(0) @db.Decimal(18, 2)
  netPnl     Decimal  @db.Decimal(18, 2)
  tradeCount Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, tradeDate])
}

model Report {
  id        String       @id @default(cuid())
  userId    String
  accountId String
  period    String // e.g. "2026-05"
  metrics   Json // computed, code-of-record
  aiReport  Json? // AI-written sections (schema in src/lib/ai)
  status    ReportStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

// Beta waitlist captured from the landing page.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

enum EvidenceKind {
  STATEMENT // broker/prop-firm statement — raises Proof Level
  PAYOUT // payout/withdrawal proof
  EXPORT // raw export (e.g. the imported CSV)
  OTHER
}

// Evidence locker — uploaded proof files. A STATEMENT raises the account's Proof Level.
model Evidence {
  id           String       @id @default(cuid())
  userId       String
  accountId    String?
  kind         EvidenceKind @default(OTHER)
  label        String?
  originalName String
  mime         String
  size         Int
  isPublic     Boolean      @default(false) // visible on the public portal
  createdAt    DateTime     @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
}
