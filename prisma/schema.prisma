// TrustSVAN - trader analytics and research-network SaaS
// Schema docs: https://pris.ly/d/prisma-schema
// DB URL is provided via prisma.config.ts (process.env.DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Auth.js (NextAuth) models — standard adapter shape.
// NOTE: `Account` here is the OAuth/credentials provider link used
// by Auth.js. A user's *brokerage* account is `TradingAccount`.
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set for credentials sign-in
  role          UserRole? // chosen at signup (or onboarding for OAuth sign-ins)
  referralCode  String?   @unique // trader invite code: /signup?ref=CODE
  referredById  String?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  profile         TraderProfile?
  clientProfile   ClientProfile?
  tradingAccounts TradingAccount[]
  reports         Report[]
  evidence        Evidence[]

  referredBy        User?             @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]            @relation("Referrals")
  follows           Follow[]
  watchlist         WatchlistItem[]
  posts             Post[]
  postComments      PostComment[]
  postLikes         PostLike[]
  postFlags         PostFlag[]
  inquiriesSent     Inquiry[]
  inquiryMessages   InquiryMessage[]
  notifications     AppNotification[]
  communitiesOwned  Community[]
  memberships       CommunityMember[]
  communityInvites  CommunityInvite[]
  profileViews      ProfileView[]
}

// Trader = publishes a record; Client = allocator / firm / reviewer who discovers traders.
enum UserRole {
  TRADER
  CLIENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Application domain
// ─────────────────────────────────────────────────────────────

model TraderProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  slug        String   @unique // public portal handle: /p/[slug]
  bio         String?
  strategy    String?
  instruments String? // free text e.g. "ES, NQ, options"
  riskRules   String?
  isPublic    Boolean  @default(false)
  hideAmounts Boolean  @default(false) // redact dollar figures on the public portal
  hideBrokers Boolean  @default(false) // redact broker + account names on the public portal
  disclaimer  String?

  // Client attraction — opt-in "open to work" signal + how prospects reach out.
  // Surfaced on the public operator card (/p/[slug]) and the /explore directory.
  // contactUrl is a single link the operator controls (email mailto:, Calendly,
  // X/LinkedIn, site) so we never expose their login email. headline is a short
  // professional tagline; services describes what they offer.
  openToWork Boolean @default(false)
  headline   String? // e.g. "Systematic futures trader · 3y verified track record"
  services   String? // e.g. "Managed research, strategy consulting, prop evaluations"
  contactUrl String? // e.g. "mailto:me@x.com", "https://cal.com/me"

  // MVP2 — living trust profile: how often the trader commits to refreshing, and
  // when the profile data was last refreshed (drives the freshness status). The
  // freshness math lives in src/lib/freshness.ts.
  updateCadence   UpdateCadence @default(MANUAL)
  lastPublishedAt DateTime? // last time the profile's data was refreshed/published

  // V1 structured identity (option keys live in src/lib/profile-options.ts).
  // Credentials + registration are self-declared and labelled as such in the UI.
  experienceYears    Int?
  markets            String[] @default([])
  strategyTags       String[] @default([])
  region             String?
  capitalBand        String?
  credentials        String?
  registrationType   String?
  registrationNumber String?
  acceptInquiries    Boolean  @default(false) // clients may request a conversation
  hiddenSections     String[] @default([]) // public-profile sections the trader has hidden

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions      ProfileVersion[]
  riskEvents    RiskEvent[]
  followers     ProfileFollower[]
  notifications NotificationEvent[]
  userFollows   Follow[]
  watchers      WatchlistItem[]
  inquiries     Inquiry[]
  views         ProfileView[]
}

// Client-side identity: what a reviewer/allocator is looking for. Drives discovery defaults.
model ClientProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  organization String?
  clientType   String? // key from CLIENT_TYPES
  markets      String[] @default([])
  regions      String[] @default([])
  strategyTags String[] @default([])
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A signed-in user following a trader profile (public count; feeds their home feed).
model Follow {
  userId    String
  profileId String
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile TraderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([userId, profileId])
  @@index([profileId])
}

// Private watchlist — never shown to the trader or anyone else.
model WatchlistItem {
  userId    String
  profileId String
  note      String?
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile TraderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([userId, profileId])
}

// One row per (profile, viewer key, day) — drives the trader's view analytics.
model ProfileView {
  id        String   @id @default(cuid())
  profileId String
  viewerId  String?
  viewerKey String // user id or hashed ip — dedupes a viewer within a day
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  profile TraderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  viewer  User?         @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@unique([profileId, viewerKey, day])
  @@index([profileId, day])
}

enum PostType {
  MARKET_VIEW
  TRADE_THESIS
  TRADE_REVIEW
  RESEARCH
  PERFORMANCE_UPDATE
  EDUCATIONAL
}

// Structured research post. `fields` holds the type-specific structure (see src/lib/posts.ts).
// `verifiedTradeId` is set only when an imported execution of the author's matches the
// symbol + date the post references — the badge is never self-asserted.
model Post {
  id              String    @id @default(cuid())
  authorId        String
  communityId     String?
  type            PostType
  title           String
  body            String
  symbols         String[]  @default([])
  fields          Json?
  verifiedTradeId String?
  versionId       String? // author's latest published record at posting time
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  removedAt       DateTime? // set by the author or a community admin

  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community     Community?      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  verifiedTrade Trade?          @relation(fields: [verifiedTradeId], references: [id], onDelete: SetNull)
  version       ProfileVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  comments      PostComment[]
  likes         PostLike[]
  flags         PostFlag[]

  @@index([authorId, createdAt])
  @@index([communityId, createdAt])
  @@index([createdAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

enum FlagStatus {
  OPEN
  RESOLVED
}

model PostFlag {
  id         String     @id @default(cuid())
  postId     String
  reporterId String
  reason     String
  status     FlagStatus @default(OPEN)
  createdAt  DateTime   @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
}

enum InquiryStatus {
  PENDING
  ACCEPTED
  DECLINED
  IGNORED
}

// A client asking a trader for a conversation. Messaging unlocks only once ACCEPTED.
model Inquiry {
  id          String        @id @default(cuid())
  clientId    String
  profileId   String
  topic       String // key from INQUIRY_TOPICS
  message     String
  status      InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  respondedAt DateTime?

  client   User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profile  TraderProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages InquiryMessage[]

  @@index([profileId, status])
  @@index([clientId])
}

model InquiryMessage {
  id        String   @id @default(cuid())
  inquiryId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

// In-app notifications (inquiries, comments, community approvals). Separate from the
// follower email queue (NotificationEvent).
model AppNotification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
}

model Community {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  description     String?
  rules           String?
  visibility      CommunityVisibility @default(PUBLIC)
  requireApproval Boolean             @default(true)
  ownerId         String
  createdAt       DateTime            @default(now())

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members CommunityMember[]
  invites CommunityInvite[]
  posts   Post[]
}

model CommunityMember {
  id          String           @id @default(cuid())
  communityId String
  userId      String
  role        CommunityRole    @default(MEMBER)
  status      MembershipStatus @default(PENDING)
  adminNote   String? // visible to community admins only
  createdAt   DateTime         @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityInvite {
  id          String    @id @default(cuid())
  communityId String
  token       String    @unique
  invitedById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  uses        Int       @default(0)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
}

// How often a trader commits to refreshing their public profile. Drives the
// freshness window in src/lib/freshness.ts (manual makes no commitment).
enum UpdateCadence {
  DAILY
  WEEKLY
  MONTHLY
  MANUAL
}

enum ImportSource {
  CSV
  MANUAL
  STATEMENT
  BROKER_API
}

// MVP2 — one row per import: the audit trail of where a profile's data came
// from. Written by src/lib/ingest/import.ts on every import. The file hash makes
// an import verifiable/idempotent; period + netPnl summarize what it contributed.
model ImportBatch {
  id               String       @id @default(cuid())
  accountId        String
  source           ImportSource @default(CSV)
  broker           String?
  originalFilename String?
  fileHash         String // sha-256 of the raw file text
  rowCount         Int // trades imported from this file
  periodStart      DateTime?    @db.Date
  periodEnd        DateTime?    @db.Date
  netPnl           Decimal      @default(0) @db.Decimal(18, 2)
  createdAt        DateTime     @default(now())

  account  TradingAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  versions ProfileVersion[]

  @@index([accountId])
  @@unique([accountId, fileHash])
}

// MVP2 — an immutable snapshot of the profile's performance at a publish moment.
// A publish never mutates a prior version: this is the "living profile" history.
// `metrics` holds the full TrustMetrics JSON (code-of-record, like Report.metrics);
// the denormalized columns exist for cheap listing/diffing. `changeSummary` is
// filled in MVP2.3.
model ProfileVersion {
  id                String    @id @default(cuid())
  profileId         String
  versionNumber     Int
  periodStart       DateTime? @db.Date
  periodEnd         DateTime? @db.Date
  metrics           Json
  netPnl            Decimal   @db.Decimal(18, 2)
  returnPct         Float? // simple return over starting balance, as a fraction
  transparencyScore Int
  proofLevel        Int
  freshnessStatus   String
  changeSummary     String?
  sourceBatchId     String?
  publishedAt       DateTime  @default(now())

  profile     TraderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceBatch ImportBatch?  @relation(fields: [sourceBatchId], references: [id], onDelete: SetNull)
  riskEvents  RiskEvent[]
  posts       Post[]

  @@unique([profileId, versionNumber])
  @@index([profileId])
}

model TradingAccount {
  id              String   @id @default(cuid())
  userId          String
  broker          String? // e.g. "Interactive Brokers", "Topstep"
  accountName     String
  currency        String   @default("USD") // ISO 4217; INR for Indian brokers
  startingBalance Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades        Trade[]
  dailyPnl      DailyPnl[]
  reports       Report[]
  evidence      Evidence[]
  importBatches ImportBatch[]

  @@index([userId])
}

model Trade {
  id          String   @id @default(cuid())
  accountId   String
  tradeDate   DateTime @db.Date
  symbol      String
  assetType   String? // future | option | stock | ...
  side        String? // BUY | SELL | LONG | SHORT
  quantity    Decimal? @db.Decimal(18, 4)
  entryPrice  Decimal? @db.Decimal(18, 6)
  exitPrice   Decimal? @db.Decimal(18, 6)
  realizedPnl Decimal  @db.Decimal(18, 2)
  fees        Decimal  @default(0) @db.Decimal(18, 2)
  raw         Json? // original CSV row, for debugging/re-import
  createdAt   DateTime @default(now())

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  posts   Post[]

  @@index([accountId, tradeDate])
}

// Per-day rollup (rebuilt from trades on import). One row per account/day.
model DailyPnl {
  id         String   @id @default(cuid())
  accountId  String
  tradeDate  DateTime @db.Date
  grossPnl   Decimal  @db.Decimal(18, 2)
  fees       Decimal  @default(0) @db.Decimal(18, 2)
  netPnl     Decimal  @db.Decimal(18, 2)
  tradeCount Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, tradeDate])
}

model Report {
  id        String       @id @default(cuid())
  userId    String
  accountId String
  period    String // e.g. "2026-05"
  metrics   Json // computed, code-of-record
  aiReport  Json? // AI-written sections (schema in src/lib/ai)
  status    ReportStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ReportStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

// Beta waitlist captured from the landing page.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

enum EvidenceKind {
  STATEMENT // broker/prop-firm statement — raises Proof Level
  TAX_RETURN // tax return / official tax record — raises Proof Level
  PAYOUT // payout/withdrawal proof
  EXPORT // raw export (e.g. the imported CSV)
  OTHER
}

// Evidence locker — uploaded proof files. A STATEMENT raises the account's Proof Level.
model Evidence {
  id           String       @id @default(cuid())
  userId       String
  accountId    String?
  kind         EvidenceKind @default(OTHER)
  label        String?
  originalName String
  mime         String
  size         Int
  isPublic     Boolean      @default(false) // visible on the public portal
  createdAt    DateTime     @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// MVP2 — risk events. Persisted, dated, plain-English flags generated when a
// profile version is published (drawdown, worst day, big-win dependency, stale
// profile, score change, recovery). Rendered as client-visible cards on the portal.
enum RiskEventType {
  DRAWDOWN
  WORST_DAY
  BIG_WIN_DEPENDENCY
  LOSS_VS_WIN
  STALE_PROFILE
  SCORE_CHANGE
  RECOVERY
}

enum RiskSeverity {
  INFO
  WARNING
  CRITICAL
}

model RiskEvent {
  id              String        @id @default(cuid())
  profileId       String
  versionId       String?
  type            RiskEventType
  severity        RiskSeverity  @default(INFO)
  eventDate       DateTime      @default(now())
  title           String
  description     String
  metricBefore    Float?
  metricAfter     Float?
  isClientVisible Boolean       @default(true)
  createdAt       DateTime      @default(now())

  profile TraderProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  version ProfileVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([profileId])
}

// MVP2 — followers/watchlist. A client subscribes by email to receive update and
// risk-change notifications. Email delivery is stubbed; notifications are queued.
enum FollowerStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum FollowFrequency {
  WEEKLY
  MONTHLY
  RISK_CHANGES_ONLY
}

model ProfileFollower {
  id         String          @id @default(cuid())
  profileId  String
  email      String
  status     FollowerStatus  @default(ACTIVE)
  frequency  FollowFrequency @default(MONTHLY)
  createdAt  DateTime        @default(now())
  verifiedAt DateTime?

  profile       TraderProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  notifications NotificationEvent[]

  @@unique([profileId, email])
  @@index([profileId])
}

enum NotificationType {
  WEEKLY_UPDATE
  MONTHLY_REPORT
  RISK_CHANGE
  STALE_PROFILE
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// Outbound notification queue. Created when a profile publishes an update or a
// risk change; actual delivery is deferred (status stays QUEUED for now).
model NotificationEvent {
  id         String             @id @default(cuid())
  profileId  String
  followerId String?
  type       NotificationType
  subject    String
  body       String
  status     NotificationStatus @default(QUEUED)
  createdAt  DateTime           @default(now())
  sentAt     DateTime?

  profile  TraderProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  follower ProfileFollower? @relation(fields: [followerId], references: [id], onDelete: SetNull)

  @@index([profileId])
}
