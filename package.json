{
  "name": "trustsvan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:set-password": "tsx scripts/set-password.ts",
    "db:admin": "tsx scripts/admin.ts",
    "temporal:check": "tsx scripts/temporal/check.ts",
    "temporal:smoke": "tsx scripts/temporal/check.ts --smoke",
    "temporal:worker": "tsx scripts/temporal/worker.ts",
    "temporal:build": "tsc -p tsconfig.temporal.json && node build/temporal/scripts/temporal/build.js",
    "temporal:start": "node build/temporal/scripts/temporal/worker.js",
    "temporal:test": "npm run temporal:build && tsx scripts/temporal/test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.18.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.42.0",
    "papaparse": "^5.5.3",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@temporalio/testing": "1.24.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
