# Copy to `.env` and fill in. Never commit real secrets.

# Postgres connection string. Local dev uses docker-compose.yml.
DATABASE_URL="postgresql://trustsvan:trustsvan@localhost:5432/trustsvan?schema=public"

# Auth.js session secret — generate with: npx auth secret
AUTH_SECRET=""

# Optional: Google sign-in. Create an OAuth client (Web) in Google Cloud Console with the
# redirect URI https://<host>/api/auth/callback/google. Google is hidden when these are empty.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI report generator. Provider: "openai" (default) or "anthropic".
AI_PROVIDER="openai"

# OpenAI (default provider). Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude (set AI_PROVIDER=anthropic to use it). https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# Optional: public Discord invite (https://discord.gg/...). When set, "Discord" appears in the
# site header and footer. Read at build time, so redeploy after changing it.
NEXT_PUBLIC_DISCORD_URL=""

# Optional: staff sign-ins (comma-separated) always use test checkout, even when Razorpay is set.
# Test purchases record the plan fee without charging it and open a simulated evaluation account.
# These addresses also receive the notice when a trader passes and a funded account opens.
STAFF_EMAILS=""

# Optional: Razorpay Standard Checkout. Without BOTH keys, public evaluations open free at ₹0.
# Set test-mode keys for gateway testing; real payments require live-mode keys and Dashboard
# auto-capture. Add https://<host>/api/razorpay/webhook in Razorpay Dashboard, subscribe to
# payment.captured and order.paid, and put that webhook's secret here (not the API key secret).
# The browser's signed response is checked against the payment API before account provisioning;
# the signed captured webhook can provision if the browser never returns. No real payment is
# implied by setting test keys, and local stand-in tests do not verify a live merchant account.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: transactional email through Resend (password resets, order confirmations). EMAIL_FROM
# must be a sender on a domain verified in Resend. Without these, emails are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional: Zerodha charts at /markets, on the firm's Kite Connect app (₹500/month at
# https://developers.kite.trade). Set the app's redirect URL to https://<host>/api/zerodha/callback.
# These WhiteSVAN sign-ins (comma-separated) connect Kite each day; every signed-in user then gets
# charts and live prices through that login.
KITE_API_KEY=""
KITE_API_SECRET=""
KITE_OWNER_EMAILS=""

# Optional: public site origin for the sitemap, robots and share images. Defaults to
# https://white-svan.vercel.app; set it when a custom domain goes live.
NEXT_PUBLIC_SITE_URL=""

# Temporal Cloud. Copy the endpoint and full namespace from the namespace page.
# Use the API-key SECRET, not its name or ID. These variables are server-only.
# See docs/temporal.md for Cloud setup, local development and worker hosting.
TEMPORAL_MODE="cloud"
TEMPORAL_ADDRESS=""
TEMPORAL_NAMESPACE=""
TEMPORAL_API_KEY=""
TEMPORAL_TASK_QUEUE="whitesvan"
