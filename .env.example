# Copy to `.env` and fill in. Never commit real secrets.

# Postgres connection string. Local dev uses docker-compose.yml.
DATABASE_URL="postgresql://whitesvan:whitesvan@localhost:5432/whitesvan?schema=public"

# Auth.js session secret — generate with: npx auth secret
AUTH_SECRET=""

# Anthropic Claude (AI report generator). Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# Default model for report generation. claude-haiku-4-5 is cheap/fast for v1.
AI_MODEL="claude-haiku-4-5-20251001"
